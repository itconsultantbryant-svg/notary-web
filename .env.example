# Copy to .env and fill in values

# PostgreSQL (Neon) — used in production on Vercel
# DATABASE_URL=postgresql://user:pass@host/db?sslmode=require

# Local dev uses JSON store (data/store.json) when DATABASE_URL is not set

# Admin account (created on first init-db run)
ADMIN_EMAIL=admin@jeffersonteahnotarypublic.com
ADMIN_PASSWORD=change-me-now

# JWT secret — use a long random string in production
JWT_SECRET=your-super-secret-jwt-key-change-in-production

# Site URL (for SEO / canonical links)
SITE_URL=https://www.jeffersonteahnotarypublic.com

# Contact form notifications (saved to admin dashboard + emailed when SMTP is set)
CONTACT_NOTIFY_EMAIL=info@jeffersonteahnotarypublic.com

# SMTP (required for email notifications — e.g. Gmail, SendGrid, Zoho)
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=your-email@gmail.com
# SMTP_PASS=your-app-password
# SMTP_FROM="Hon. Jefferson Teah Notary <info@jeffersonteahnotarypublic.com>"

# Optional: one-time production DB setup via GET /api/setup?secret=YOUR_SETUP_SECRET
SETUP_SECRET=your-setup-secret-here
