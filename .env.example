# Copy to .env and fill in values

# PostgreSQL (Neon) — used in production on Vercel
# DATABASE_URL=postgresql://user:pass@host/db?sslmode=require

# Local dev uses SQLite (data/notary.db) when DATABASE_URL is not set

# Admin account (created on first init-db run)
ADMIN_EMAIL=admin@jeffersonteahnotarypublic.com
ADMIN_PASSWORD=change-me-now

# JWT secret — use a long random string in production
JWT_SECRET=your-super-secret-jwt-key-change-in-production

# Site URL (for SEO / canonical links)
SITE_URL=https://www.jeffersonteahnotarypublic.com

# Optional: email notifications for contact forms (SMTP not configured by default)
CONTACT_NOTIFY_EMAIL=info@jeffersonteahnotarypublic.com

PORT=3000
